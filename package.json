{
  "name": "vorrat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "audit": "npm audit --audit-level=moderate",
    "secrets": "secretlint --secretlintrc config/leakscan.json --secretlintignore config/leakscan-ignore \"**/*\"",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run audit && npm run secrets",
    "hooks:install": "husky"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "secretlint": "14.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.6"
    }
  }
}
